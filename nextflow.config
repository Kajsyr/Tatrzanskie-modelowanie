includeConfig 'login.config'
params{
    // pubblisDir/output
    output_dir = "${projectDir}/output"
    output_features = "${params.output_dir}/features"
    output_gee = "${params.output_dir}/gee"

    // cache
    cache_dir = "${projectDir}/cache"
    cache_gee = "${params.cache_dir}/gee"

    //envs
    project_envs = "${projectDir}/envs"

    species_file = "${projectDir}/input/FLORA_UJ_TPN.xlsx"

    alp_shapefile = "${projectDir}/input/Alpy/BiogeoRegions2016_Alpine_ExportFeatures.shp"

    //gee download parameters
    max_requests = 4
    max_tile_size = 8
    

}

conda {
    enabled = true
}

process {
    withName: '.*GEE:.*' {
        maxForks = 1
        errorStrategy = 'retry'
        maxRetries = 4
    }
}


resume = true