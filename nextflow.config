//includeConfig 'login.config'
params{

    output_dir = "${projectDir}/output"

    // cache
    cache_dir = "${projectDir}/cache"

    //envs
    project_envs = "${projectDir}/envs"
}

// Parametry wejściowe
params.species_file = "${projectDir}/input/FLORA_UJ_TPN.xlsx"
params.alp_shapefile = "${projectDir}/input/Alpy/BiogeoRegions2016_Alpine_ExportFeatures.shp"

process {
    cpus = 7
}


conda {
    enabled = true
}

resume = true